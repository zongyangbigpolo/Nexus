# Copy to .env or export these values in your shell.
# Shell environment variables always take precedence over this file.

# Agent execution model. Supported values: openai, deepseek, openrouter, gemini, ollama.
EVAL_PROVIDER=
EVAL_MODEL=
EVAL_API_KEY=
EVAL_BASE_URL=

# Optional separate grader model. If unset, falls back to EVAL_* and provider-specific keys.
GRADER_PROVIDER=
GRADER_MODEL=
GRADER_API_KEY=
GRADER_BASE_URL=

# OpenAI-compatible provider examples.
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=